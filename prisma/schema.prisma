datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TaskModel {
  id          String   @id
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  USER
}

model UserModel {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String // hash de bcrypt, nunca texto plano
  role         Role   @default(USER)
}
